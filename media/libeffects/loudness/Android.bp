// LoudnessEnhancer library
package {
    default_applicable_licenses: [
        "frameworks_av_media_libeffects_loudness_license",
    ],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "frameworks_av_media_libeffects_loudness_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library {
    name: "libldnhncr",

    vendor: true,
    srcs: [
        "EffectLoudnessEnhancer.cpp",
        "dsp/core/dynamic_range_compression.cpp",
    ],

    cflags: [
        "-O2",
        "-fvisibility=hidden",
        "-fstack-protector-all",
        "-fno-builtin-__memcpy_chk",
        "-fno-builtin-__memset_chk",
        "-fno-builtin-__memmove_chk",
        "-fno-builtin-__strcpy_chk",
        "-fno-builtin-__snprintf_chk",
        "-U_FORTIFY_SOURCE",
        "-D_FORTIFY_SOURCE=2",

        "-Wall",
        "-Werror",
    ],
    ldflags: [
        "-Wl,-u,__memcpy_chk",
        "-Wl,-u,__memset_chk",
        "-Wl,-u,__memmove_chk",
        "-Wl,-u,__strcpy_chk",
        "-Wl,-u,__snprintf_chk",
    ],

    shared_libs: [
        "libaudioutils",
        "libcutils",
        "liblog",
    ],

    relative_install_path: "soundfx",

    header_libs: ["libaudioeffects"],
}

cc_library_shared {
    name: "libloudnessenhanceraidl",
    srcs: [
        "aidl/EffectLoudnessEnhancer.cpp",
        "aidl/LoudnessEnhancerContext.cpp",
        "dsp/core/dynamic_range_compression.cpp",
    ],
    defaults: [
        "aidlaudioeffectservice_defaults",
    ],
    header_libs: [
        "libaudioeffects",
        "libhardware_headers",
    ],
    cflags: [
        "-Wthread-safety",
        "-fstack-protector-all",
        "-fno-builtin-__memcpy_chk",
        "-fno-builtin-__memset_chk",
        "-fno-builtin-__memmove_chk",
        "-fno-builtin-__strcpy_chk",
        "-fno-builtin-__snprintf_chk",
        "-U_FORTIFY_SOURCE",
        "-D_FORTIFY_SOURCE=2",
    ],
    ldflags: [
        "-Wl,-u,__memcpy_chk",
        "-Wl,-u,__memset_chk",
        "-Wl,-u,__memmove_chk",
        "-Wl,-u,__strcpy_chk",
        "-Wl,-u,__snprintf_chk",
    ],
    shared_libs: [
        "libaudioutils",
        "libcutils",
        "liblog",
    ],
    relative_install_path: "soundfx",
    visibility: [
        "//hardware/interfaces/audio/aidl/default:__subpackages__",
    ],
}
