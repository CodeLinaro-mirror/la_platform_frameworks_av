// audio preprocessing wrapper
package {
    default_team: "trendy_team_media_framework_audio",
    default_applicable_licenses: [
        "frameworks_av_media_libeffects_preprocessing_license",
    ],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "frameworks_av_media_libeffects_preprocessing_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_defaults {
    name: "libaudiopreprocessing-defaults",
    vendor: true,
    host_supported: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wno-unused-parameter",
        "-fstack-protector-strong",
        "-fno-builtin-__memcpy_chk",
        "-fno-builtin-__memset_chk",
        "-fno-builtin-__memmove_chk",
        "-fno-builtin-__strcpy_chk",
        "-fno-builtin-__snprintf_chk",
    ],
    ldflags: [
        "-Wl,-u,__memcpy_chk",
        "-Wl,-u,__memset_chk",
        "-Wl,-u,__memmove_chk",
        "-Wl,-u,__strcpy_chk",
        "-Wl,-u,__snprintf_chk",
    ],

    shared_libs: [
        "liblog",
        "libutils",
    ],

    static_libs: [
        "webrtc_audio_processing",
    ],

    header_libs: [
        "libaudioeffects",
        "libhardware_headers",
    ],
    target: {
        vendor: {
            cflags: ["-U_FORTIFY_SOURCE", "-D_FORTIFY_SOURCE=2"],
        },
        darwin: {
            enabled: false,
        },
    },
}

cc_library {
    name: "libaudiopreprocessing",
    defaults: ["libaudiopreprocessing-defaults"],
    relative_install_path: "soundfx",
    srcs: ["PreProcessing.cpp"],
    static_libs: [
        "absl_strings_string_view",
        "absl_types_optional",
    ],
}

cc_library_shared {
    name: "libpreprocessingaidl",
    srcs: [
        "aidl/EffectPreProcessing.cpp",
        "aidl/PreProcessingContext.cpp",
    ],
    defaults: [
        "aidlaudioeffectservice_defaults",
    ],
    local_include_dirs: ["aidl"],
    shared_libs: [
        "libaudioutils",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "absl_strings_string_view",
        "absl_types_optional",
        "webrtc_audio_processing",
    ],
    header_libs: [
        "libaudioeffects",
        "libhardware_headers",
    ],
    cflags: [
        "-Wno-unused-parameter",
        "-Wthread-safety",
        "-fstack-protector-strong",
        "-fno-builtin-__memcpy_chk",
        "-fno-builtin-__memset_chk",
        "-fno-builtin-__memmove_chk",
        "-fno-builtin-__strcpy_chk",
        "-fno-builtin-__snprintf_chk",
    ],
    ldflags: [
        "-Wl,-u,__memcpy_chk",
        "-Wl,-u,__memset_chk",
        "-Wl,-u,__memmove_chk",
        "-Wl,-u,__strcpy_chk",
        "-Wl,-u,__snprintf_chk",
    ],
    relative_install_path: "soundfx",
    visibility: [
        "//hardware/interfaces/audio/aidl/default:__subpackages__",
    ],
}
